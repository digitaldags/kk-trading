# Postgres connection string from Neon. The Vercel Marketplace integration injects it (ticket 04).
DATABASE_URL=

# Read/write token for the Vercel Blob store that holds product photos (ticket 10).
BLOB_READ_WRITE_TOKEN=

# Secret for signing the admin session cookie. Use 32+ random bytes, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Email of the first admin user, created by `pnpm db:seed`.
ADMIN_EMAIL=

# Password for the first admin, used once by the seed. Remove it after the first sign-in.
ADMIN_INITIAL_PASSWORD=
