# Postgres connection string from Neon. The Vercel Marketplace integration injects it on Vercel.
# Locally, use your Neon `dev` branch here (see README › Database). Never point .env.local at production.
DATABASE_URL=

# Read/write token for the Vercel Blob store that holds product photos. Needed to upload photos
# in admin. On Vercel the Blob integration sets it; locally copy it from Vercel › Storage › Blob.
BLOB_READ_WRITE_TOKEN=

# Secret for signing the admin session cookie: at least 32 bytes, e.g. `openssl rand -base64 32`.
# Use a different one in each environment (local, Vercel Preview, Vercel Production).
SESSION_SECRET=

# Email of the first admin user, created by `pnpm db:seed`.
ADMIN_EMAIL=

# Password for the first admin (12+ characters), used once by the seed. Remove it after the first sign-in.
ADMIN_INITIAL_PASSWORD=

# Local only, never on Vercel: the test account the admin e2e specs sign in with.
# Create it with `pnpm db:admin --email <name> --password <password> --allow-weak-password`.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
